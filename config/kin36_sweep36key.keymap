#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define MOUSE 2
#define NUM  3

// Переопределяем системные настройки мыши (выносим КОРЕНЬ файла)
&mmv {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <500>;
    delay-ms = <0>;
};

/ {
    behaviors {
        // Home Row Mods
        hrm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            // Удалили устаревший параметр label
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <120>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // === COMBO FOR THE LAYER BASE ===
        // 1. Combo for the Russian letter "х" ("щ" + "з")
        combo_base_ru_kh {
            timeout-ms = <50>;
            key-positions = <6 7>; // U + I
            bindings = <&kp LBKT>;
            layers = <0>;
        };

        // 2. Combo for the Russian letter "э" ("д" + "ж")
        combo_base_ru_ae {
            timeout-ms = <50>;
            key-positions = <16 17>; // J + K
            bindings = <&kp SQT>;
            layers = <0>;
        };

        // 3. Combo for the Russian letter "ъ" ("т" + "ь")
        combo_base_ru_hard_sign {
            timeout-ms = <50>;
            key-positions = <26 27>; // M + ,
            bindings = <&kp RBKT>;
            layers = <0>;
        };

        // === COMBO FOR THE LAYER NUM ===
        // 1. Combo for the letter "\" ("f" + "g")
        // ZMK: Option + F (code 3) -> XML: "\"
        combo_num_bslh {
            timeout-ms = <50>;
            key-positions = <13 14>; // F + G
            bindings = <&kp RA(F)>;
            layers = <3>;
        };

        // 2. Combo for the letter "~" ("y" + "u")
        // ZMK: Option + D (code 2) -> XML: "~"
        combo_num_tilde {
            timeout-ms = <50>;
            key-positions = <5 6>; // Y + U
            bindings = <&kp RA(D)>;
            layers = <3>;
        };

        // 3. Combo for the letter "@" ("u" + "i")
        // ZMK: Option + W (code 13) -> XML: "@"
        combo_num_at {
            timeout-ms = <50>;
            key-positions = <6 7>; // U + I
            bindings = <&kp RA(W)>;
            layers = <3>;
        };

        // 4. Combo for the letter "'" ("i" + "o")
        combo_num_sqt {
            timeout-ms = <50>;
            key-positions = <7 8>; // I + O
            bindings = <&kp RA(SQT)>;
            layers = <3>;
        };

        // 5. Combo for the letter "`" ("o" + "p")
        combo_num_grave {
            timeout-ms = <50>;
            key-positions = <8 9>; // O + P
            bindings = <&kp RA(GRAVE)>;
            layers = <3>;
        };

        // 6. Combo for the letter "#" ("j" + "k")
        // ZMK: Option + E (code 14) -> XML: "#"
        combo_num_hash {
            timeout-ms = <50>;
            key-positions = <16 17>; // J + K
            bindings = <&kp RA(E)>;
            layers = <3>;
        };

        // 7. Combo for the letter ";" ("l" + ";")
        combo_num_semi {
            timeout-ms = <50>;
            key-positions = <18 19>; // L + ;
            bindings = <&kp RA(S)>;
            layers = <3>;
        };

        // 8. Combo for the letter "$" ("m" + ",")
        // ZMK: Option + R (code 15) -> XML: "$"
        combo_num_dollar {
            timeout-ms = <50>;
            key-positions = <26 27>; // M + ,
            bindings = <&kp RA(R)>;
            layers = <3>;
        };

        // 9. Combo for the change language
        combo_lang {
            timeout-ms = <50>;
            key-positions = <31 32>;
            bindings = <&kp LC(SPACE)>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // === 0. BASE LAYER ===
        default_layer {
            display-name = "default";
            bindings = <
                &kp Q        &kp W        &kp E        &kp R        &kp T                                           &kp Y        &kp U        &kp I        &kp O        &kp P
                &hrm LCTRL A &hrm LALT S  &hrm LGUI D  &hrm LSHIFT F &kp G                                          &kp H        &hrm LSHIFT J &hrm LGUI K  &hrm LALT L  &hrm LCTRL SEMI
                &kp Z        &kp X        &kp C        &kp V        &kp B                                           &kp N        &kp M        &kp COMMA    &kp DOT      &kp GRAVE
                                          &lt MOUSE ESC    &kp TAB  &lt NAV SPACE                                   &lt NUM ENTER &kp BSPC     &kp DEL
            >;
        };

        // === 1. NAVIGATION LAYER ===
        nav_layer {
            display-name = "navigation";
            bindings = <
                &none        &none        &none        &none        &none                                           &kp LG(LS(Z)) &kp LG(V)    &kp LG(C)    &kp LG(X)    &kp LG(Z)
                &trans       &trans       &trans       &trans       &none                                           &kp CAPSLOCK  &kp LEFT     &kp DOWN     &kp UP       &kp RIGHT
                &none        &none        &kp LG(LS(N3)) &kp LG(LS(N4)) &none                                       &kp LG(FSLH)  &kp HOME     &kp PG_UP    &kp PG_DN    &kp END
                                          &trans       &trans       &trans                                          &trans        &trans       &trans
            >;
        };

        // === 2. MOUSE LAYER ===
        mouse_layer {
            display-name = "mouse";
            bindings = <
                &none        &none        &none        &none        &none                                           &kp LG(LS(Z)) &kp LG(V)    &kp LG(C)    &kp LG(X)    &kp LG(Z)
                &trans       &trans       &trans       &trans       &none                                           &none         &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT
                &none        &none        &none        &none        &none                                           &trans        &msc SCRL_LEFT &msc SCRL_UP   &msc SCRL_DOWN &msc SCRL_RIGHT
                                          &trans       &trans       &trans                                          &mkp LCLK     &mkp RCLK    &trans
            >;
        };

        // === 3. NUMBERS LAYER ===
        num_layer {
            display-name = "numbers";
            bindings = <
                &kp PLUS     &kp N7       &kp N8       &kp N9       &kp ASTRK                                       &kp RA(Y)    &kp RA(U)    &kp RA(I)    &kp RA(O)    &kp RA(P)
                &kp MINUS    &kp N4       &kp N5       &kp N6       &kp RA(G)                                       &kp UNDER    &kp RA(J)    &kp RA(K)    &kp RA(L)    &kp RA(SEMI)
                &kp EQUAL    &kp N1       &kp N2       &kp N3       &kp PRCNT                                       &kp RA(N)    &kp RA(M)    &kp RA(COMMA) &kp RA(DOT)  &kp RA(FSLH)
                                          &kp N0       &kp RA(V)    &trans                                          &trans       &trans       &trans
            >;
        };
    };
};