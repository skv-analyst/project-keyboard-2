#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define MOUSE 2
#define NUM  3

/ {
    behaviors {
        // Home Row Mods
        hrm: home_row_mod {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD";
            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <120>;
            require-prior-idle-ms = <100>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Mouse smoothness
        mmv {
            acceleration-exponent = <1>;
            time-to-max-speed-ms = <500>;
            delay-ms = <0>;
        };

        // Mouse scroll
        msc {
            acceleration-exponent = <1>;
            time-to-max-speed-ms = <500>;
            delay-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // === COMBO FOR THE LAYER BASE ===
        // 1. Combo for the Russian letter "х" ("щ" + "з")
        combo_base_ru_kh {
            timeout-ms = <50>;
            key-positions = <21 22>; // Key indexes on Sofle
            bindings = <&kp LBKT>;
            layers = <0>;
        };

        // 2. Combo for the Russian letter "э" ("д" + "ж")
        combo_base_ru_ae {
            timeout-ms = <50>;
            key-positions = <33 34>; // Key indexes on Sofle
            bindings = <&kp SQT>;
            layers = <0>;
        };

        // 3. Combo for the Russian letter "ъ" ("т" + "ь")
        combo_base_ru_hard_sign {
            timeout-ms = <50>;
            key-positions = <44 45>; // Key indexes on Sofle
            bindings = <&kp RBKT>;
            layers = <0>;
        };

        // === COMBO FOR THE LAYER NUM ===
        // 1. Combo for the letter "'" ("i" + "o")
        combo_num_sqt {
            timeout-ms = <50>;
            key-positions = <20 21>; // I + O
            bindings = <&kp RA(SQT)>;
            layers = <3>;
        };

        // 2. Combo for the letter "`" ("o" + "p")
        combo_num_grave {
            timeout-ms = <50>;
            key-positions = <21 22>; // Key indexes on Sofle
            bindings = <&kp RA(GRAVE)>;
            layers = <3>;
        };

        // 3. Combo for the letter ";" ("l" + ";")
        combo_num_semi {
            timeout-ms = <50>;
            key-positions = <33 34>; // Key indexes on Sofle
            bindings = <&kp RA(S)>;
            layers = <3>;
        };

        // 4. Combo for the letter "@" ("u" + "i")
        // ZMK: Option + W (code 13) -> XML: @
        combo_num_at {
            timeout-ms = <50>;
            key-positions = <19 20>; // Key indexes on Sofle
            bindings = <&kp RA(W)>;
            layers = <3>;
        };

        // 5. Combo for the letter "#" ("j" + "k")
        // ZMK: Option + E (code 14) -> XML: #
        combo_num_hash {
            timeout-ms = <50>;
            key-positions = <31 32>; // Key indexes on Sofle
            bindings = <&kp RA(E)>;
            layers = <3>;
        };

        // 6. Combo for the letter "$" ("m" + ",")
        // ZMK: Option + R (code 15) -> XML: $
        combo_num_dollar {
            timeout-ms = <50>;
            key-positions = <45 46>; // Key indexes on Sofle
            bindings = <&kp RA(R)>;
            layers = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // === 0. BASE LAYER ===

        default_layer {
            display-name = "default";
            bindings = <
                &none  &none         &none        &none        &none          &none                                          &none     &none          &none        &none        &none            &none
                &none  &kp Q         &kp W        &kp E        &kp R          &kp T                                          &kp Y     &kp U          &kp I        &kp O        &kp P            &none
                &none  &hrm LCTRL A  &hrm LALT S  &hrm LGUI D  &hrm LSHIFT F  &kp G                                          &kp H     &hrm LSHIFT J  &hrm LGUI K  &hrm LALT L  &hrm LCTRL SEMI  &none
                &none  &kp Z         &kp X        &kp C        &kp V          &kp B          &kp C_MUTE       &none          &kp N     &kp M          &kp COMMA     &kp DOT      &kp GRAVE        &none
                                     &none        &kp ESCAPE   &kp LC(SPACE)  &lt MOUSE TAB  &lt NAV SPACE    &lt NUM ENTER  &kp BSPC  &kp DEL        &kp NUBS       &kp INT3
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // === 1. NAVIGATION LAYER ===

        nav_layer {
            display-name = "navigation";
            bindings = <
                &none  &none   &none   &none   &none   &none                     &none          &none      &none      &none      &none      &none
                &none  &none   &none   &none   &none   &none                     &kp LG(LS(Z))  &kp LG(V)  &kp LG(C)  &kp LG(X)  &kp LG(Z)  &none
                &none  &trans  &trans  &trans  &trans  &none                     &kp CAPSLOCK   &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &none
                &none  &none   &none   &kp LG(LS(N3))  &kp LG(LS(N4))   &none   &trans    &trans  &kp INS        &kp HOME   &kp PG_DN  &kp PG_UP  &kp END    &none
                               &trans  &trans  &trans  &trans  &trans    &trans  &trans         &trans     &trans     &trans
            >;
        };

        // === 2. MOUSE LAYER ===

        mouse_layer {
            display-name = "mouse";
            bindings = <
                &none  &none   &none   &none   &none   &none                        &none          &none           &none           &none           &none            &none
                &none  &none   &none   &none   &none   &none                        &kp LG(LS(Z))  &kp LG(V)       &kp LG(C)       &kp LG(X)       &kp LG(Z)        &none
                &none  &trans  &trans  &trans  &trans  &none                        &none          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT  &none
                &none  &none   &none   &none   &none   &none   &trans    &trans     &none          &msc SCRL_LEFT  &msc SCRL_UP    &msc SCRL_DOWN  &msc SCRL_RIGHT  &none
                               &trans  &trans  &trans  &trans  &trans    &mkp LCLK  &mkp RCLK      &trans          &trans          &trans
            >;
        };

        // === 3. NUMBERS LAYER ===

        num_layer {
            display-name = "numbers";
            bindings = <
                &none  &none      &none   &none   &none   &none                        &none          &none        &none         &none         &none          &none
                &none  &kp RA(Q)  &kp N7  &kp N8  &kp N9  &kp RA(T)                    &kp RA(Y)      &kp RA(U)    &kp RA(I)     &kp RA(O)     &kp RA(P)      &none
                &none  &kp RA(A)  &kp N4  &kp N5  &kp N6  &kp RA(G)                    &kp RA(H)      &kp RA(J)    &kp RA(K)     &kp RA(L)     &kp RA(SEMI)   &none
                &none  &kp RA(Z)  &kp N1  &kp N2  &kp N3  &kp RA(B)  &trans    &trans  &kp RA(N)      &kp RA(M)    &kp RA(COMMA) &kp RA(DOT)   &kp RA(FSLH)   &none
                                  &trans  &trans  &kp RA(V) &kp N0     &trans    &trans  &trans         &trans       &trans        &trans
            >;
        };
    };
};
